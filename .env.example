OPENRUN_PUBLIC_URL=http://localhost:4340
# Waiting-only service: set here or in the SOPS/Kubernetes Secret.
# DATABASE_URL=postgresql://openrun_app:CHANGE_ME@postgres.database.svc.cluster.local:5432/openrun
# Optional separate DDL role for waiting:db:migrate.
# WAITING_MIGRATION_DATABASE_URL=postgresql://openrun_migrations:CHANGE_ME@postgres.database.svc.cluster.local:5432/openrun
# Path to Google ADC or a Workload Identity Federation credential configuration.
# OPENRUN_GOOGLE_CREDENTIALS_FILE=/absolute/path/to/credentials.json
